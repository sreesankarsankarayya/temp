# Application name. Defaults to the project folder name.
# Used for DB file names and the localtunnel subdomain.
APP_NAME=temp

# Environment. Anything other than PRD/None is shown as a badge in the top bar
# and appended to the tunnel subdomain: <app-name>-<env>.loca.lt
ENV=DEV

# Where SQLite DBs, logs, backups and upgrade bundles live (mount a volume here).
DATA_DIR=/data

# Secret used for JWT signing and to derive the Fernet key that encrypts LLM API keys.
# CHANGE THIS IN ANY REAL DEPLOYMENT.
SECRET_KEY=change-me-please-32-chars-minimum

# Shared secret used to verify signed upgrade bundles (HMAC-SHA256 over the bundle).
UPGRADE_SIGNING_KEY=change-me-upgrade-signing-key

# Initial admin credentials (only used on first boot when the user table is empty).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Set to 0 to disable the localtunnel started by the container entrypoint.
ENABLE_TUNNEL=1
